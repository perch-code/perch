<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#faf1d8" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#24231f" media="(prefers-color-scheme: dark)">
<title>$title</title>
<meta name="description" content="$description">
$social$site_name
<link rel="icon" href="${prefix}img/wren-ink.svg?v=4" type="image/svg+xml" sizes="any">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Hanken+Grotesk:wght@400;500;600&display=swap">
<link rel="stylesheet" href="${prefix}site.css?v=40">
$page_css
</head>
<body class="$page_class">
<a class="skip-link" href="#main-content">Skip to content</a>

<header class="bar">
  <div class="wrap">
    <a class="brand" href="${prefix}index.html"><img src="${prefix}img/wren-ink.svg?v=4" alt="">Perch</a>
    <nav aria-label="Main">
      <a class="nav-guide"$guide_current href="${prefix}guide/index.html" aria-label="Field guide" title="Field guide"></a>
      <a class="nav-download" href="#$install_id" aria-label="Install Perch" title="Install Perch">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M4 16v4h16v-4"/></svg>
      </a>
      <a class="nav-github" href="https://github.com/perch-code/perch"><span>GitHub</span></a>
    </nav>
  </div>
</header>

$content
<footer class="foot">
  <div class="wrap">
    <div class="closing-spread">
      <section class="install" id="$install_id" aria-labelledby="install-title">
        <h2 id="install-title">Install <em>Perch</em></h2>
        <p>For macOS and Linux.</p>
        <div class="cmd">
          <pre id="install-cmd"><code>curl -fsSL $install_url | sh</code></pre>
          <button type="button" data-copy="install-cmd" aria-label="Copy install command" title="Copy install command">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <g class="copy-icon"><rect x="8" y="8" width="12" height="13" rx="2"/><path d="M15 5V4a1 1 0 0 0-1-1H5a2 2 0 0 0-2 2v10a1 1 0 0 0 1 1h1"/></g>
              <path class="copied-icon" d="m4 12 5 5L20 6"/>
            </svg>
          </button>
        </div>
        <span class="copy-status" role="status"></span>
      </section>
      <a id="field-guide" class="guide-cover" href="${prefix}guide/index.html">
        <span class="cover-title">The Perch <em>Field Guide</em></span>
        <img src="${prefix}img/wren.svg?v=2" alt="" width="128" height="128">
      </a>
    </div>
  </div>
</footer>
<script src="${prefix}site.js?v=13"></script>
$page_scripts
</body></html>
